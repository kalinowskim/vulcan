IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_PROCESSED_FOLDER=Processed

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# domyślni odbiorcy (dla kont bez własnego VULCAN_<NAZWA>_MAIL_TO); kilka po przecinku
MAIL_TO=

# Konta eduVULCAN: nazwy po przecinku (a-z, 0-9, _ -), dla każdej VULCAN_<NAZWA>_LOGIN/_PASSWORD/_MAIL_TO.
# Wiadomości z danego konta idą na jego MAIL_TO. Nowe konto: dopisz tutaj i uruchom --init --account <nazwa>.
VULCAN_ACCOUNTS=mateusz,aga

VULCAN_MATEUSZ_LOGIN=
VULCAN_MATEUSZ_PASSWORD=
VULCAN_MATEUSZ_MAIL_TO=

VULCAN_AGA_LOGIN=
VULCAN_AGA_PASSWORD=
VULCAN_AGA_MAIL_TO=

# Jedno konto (zapis z poprzedniej wersji) — używane tylko, gdy VULCAN_ACCOUNTS jest puste:
# VULCAN_LOGIN=
# VULCAN_PASSWORD=

POLL_INTERVAL_MINUTES=5
# pełne sprawdzenie Vulcana co tyle minut, nawet bez powiadomienia (0 = wyłączone)
FULL_CHECK_INTERVAL_MINUTES=60
# adres/domena nadawcy powiadomień Vulcana; kilka rozdziel przecinkiem
# (np. własny adres, z którego ręcznie przekazujesz powiadomienia)
NOTIFICATION_SENDER_FILTER=noreply@vulcan.net.pl
# odbiorcy alertów o błędach; domyślnie MAIL_TO, a bez niego — adresy wszystkich kont
ALERT_EMAIL_TO=

# opcjonalnie: ścieżki (domyślnie względem katalogu roboczego)
# STATE_DIR=state
# DEBUG_DIR=debug
# DB_PATH=state/forwarder.db
